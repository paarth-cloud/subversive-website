# Where the contact form posts leads. Any endpoint that accepts JSON works:
# your own API route, a CRM webhook (HubSpot, Attio, Pipedrive) or a form
# service such as Formspree. Leave empty to run the form in demo mode, where
# submissions are validated and the success state plays, but nothing is sent.
VITE_LEAD_ENDPOINT=

# Optional. A scheduling link (Cal.com, Calendly, HubSpot Meetings) shown in
# the success state so prospects can pick a time straight away.
VITE_BOOKING_URL=

# Public site URL, used for canonical and Open Graph tags at build time.
VITE_SITE_URL=https://aisubversive.com
